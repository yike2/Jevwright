// The Backend's tables (docs/tech/backend.md 3.3). Run Files live in RUNS_DIR, never here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
  runs         Run[]
}

model Project {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  folders   Folder[]
  testFiles TestFile[]
  variables Variable[]
  runs      Run[]

  @@unique([userId, name])
}

model Variable {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@unique([projectId, name])
}

// A folder sits directly in its Project (parentId null) or in another folder of the same Project. The API keeps it
// at most 4 levels deep, counting the Project (backend.md 1.3).
model Folder {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?    @db.Uuid
  parent    Folder?    @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  folders   Folder[]   @relation("Subfolders")
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  testFiles TestFile[]

  // NULLS NOT DISTINCT in the migration, so names are unique directly in the Project too.
  @@unique([projectId, parentId, name])
}

// A Test File sits directly in its Project (folderId null) or in one of the Project's folders.
model TestFile {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId  String?  @db.Uuid
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name      String
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  // NULLS NOT DISTINCT in the migration, like Folder's.
  @@unique([projectId, folderId, name])
}

enum RunStatus {
  queued
  running
  passed
  failed
}

// Runs outlive their Test File and Project: those ids become null, the copied source and path stay.
model Run {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testFileId   String?   @db.Uuid
  testFile     TestFile? @relation(fields: [testFileId], references: [id], onDelete: SetNull)
  projectId    String?   @db.Uuid
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileName     String
  path         String // The file's path in its Project when the Run was triggered, e.g. checkout/wrong-total.yaml
  name         String
  source       String
  status       RunStatus @default(queued)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  total        Int?
  passed       Int?
  failed       Int?
  pending      Int?
  errorKind    String?
  errorMessage String?
  report       Json?

  @@index([testFileId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}
