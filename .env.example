OPENROUTER_API_KEY=
SWAG_PASSWORD=

# Backend (docs/tech/backend.md 1.8)
# postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=
# at least 32 characters
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
RUNS_DIR=./data/runs
RUN_CONCURRENCY=1
PORT=4000
# 127.0.0.1 keeps a local backend off your network; the Docker image sets 0.0.0.0
HOST=127.0.0.1
# ws:// URL of the browser container (compose sets it); leave it out to launch Chromium locally
# BROWSER_ENDPOINT=ws://localhost:3000/

# Deploy (compose.yaml, docs/tech/backend.md 1.9). JWT_SECRET, OPENROUTER_API_KEY, CORS_ORIGIN (the frontend's
# https:// origin), and RUN_CONCURRENCY above apply too; DATABASE_URL, RUNS_DIR, PORT, HOST, and BROWSER_ENDPOINT are set by compose.
# e.g. api.example.com
API_DOMAIN=
# e.g. demo.example.com: the benchmark Demo App, which tests reach as the Project Variable BASE
DEMO_DOMAIN=
# e.g. app.example.com: the frontend; CORS_ORIGIN must be https://<APP_DOMAIN> (docs/deploy/frontend-prod.md)
APP_DOMAIN=
POSTGRES_PASSWORD=
