#!/usr/bin/env bash
# Format: <type>(<scope>): <summary> (#<issue>), then optional blank line + <description>.
# See .gitmessage and AGENTS.md section 6.2.
types="feat|fix|docs|test|refactor|chore|ci"
msg=$(grep -v '^#' "$1")
title=$(sed -n 1p <<<"$msg")

fail() { echo "✖ Commit message: $1 (see .gitmessage)" >&2; exit 1; }
[[ -n $title ]] || fail "title is required"
# Merge and Revert titles are generated by git, so they skip the format check.
if [[ ! $title =~ ^(Merge|Revert)\  ]]; then
  [[ $title =~ ^($types)\(([a-z][a-z0-9-]*)\):\ ([^[:space:]].*)\ \(#[0-9]+\)$ ]] ||
    fail "title must look like \"feat(locator): add DOM fallback (#42)\" (types: ${types//|/, })"
  (( ${#title} <= 72 )) || fail "title is ${#title} characters, max 72"
fi
[[ -z $(sed -n 2p <<<"$msg") ]] || fail "line 2 must be blank"
