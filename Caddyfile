# HTTPS for the backend (backend.md 1.9); Caddy gets and renews the certificate for API_DOMAIN.
# reverse_proxy also carries Live Progress's WebSocket upgrades. No access log is written, since Run File
# and Live Progress URLs carry the login token as ?token= (backend.md 1.2).
{$API_DOMAIN} {
	reverse_proxy backend:4000
}

# The frontend (docs/deploy/frontend-prod.md); the browser calls the API at API_DOMAIN directly.
{$APP_DOMAIN} {
	reverse_proxy frontend:3000
}

# The preview environment (compose.preview.yaml, docs/deploy/ci-cd.md 4), reached through the jevwright-edge network.
# While no preview is running, these sites answer 502; production is unaffected.
{$PREVIEW_API_DOMAIN} {
	reverse_proxy preview-backend:4000
}

{$PREVIEW_APP_DOMAIN} {
	reverse_proxy preview-frontend:3000
}

# The benchmark Demo App's site, kept in its own file so it can also be served alone (docs/deploy/demo-app.md).
import /etc/caddy/demo-app.Caddyfile
