# HTTPS for the backend (backend.md 1.9); Caddy gets and renews the certificate for API_DOMAIN.
# reverse_proxy also carries Live Progress's WebSocket upgrades. No access log is written, since Run File
# and Live Progress URLs carry the login token as ?token= (backend.md 1.2).
{$API_DOMAIN} {
	reverse_proxy backend:4000
}

# The benchmark Demo App (docs/tech/benchmark.md 1.2), served from the repository like serveDemoApp(): our extra
# pages under /extras/, the static build elsewhere, and index.html for the app's client routes. Runs block private
# addresses, so tests reach it here, at its public domain, through the Project Variable BASE.
{$DEMO_DOMAIN} {
	handle_path /extras/* {
		root * /srv/demo/extras
		file_server
	}
	handle {
		root * /srv/demo/site
		try_files {path} /index.html
		file_server
	}
}
