{
  "name": "Jevwright",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage",
    "jevwright": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:live": "vitest run --config vitest.live.config.ts src/tests/live",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "playwright": "1.64.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}